{
  "name": "ile-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Node.js backend for Ilé — real auth, real persistence (SQLite locally, Postgres in production), real search ranking.",
  "main": "src/server.js",
  "scripts": {
    "seed": "node src/seed.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test src/api.test.js",
    "test:backup": "node --test src/backup.test.js",
    "migrate": "node src/migrate.js",
    "backup": "node src/backup.js",
    "restore": "node src/restore.js",
    "backup:drill": "node src/backup-drill.js"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "@aws-sdk/client-s3": "^3.658.0"
  },
  "engines": {
    "node": ">=18"
  }
}
